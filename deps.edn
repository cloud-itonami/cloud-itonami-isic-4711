{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;; `kotoba-lang/retail` is the bespoke domain capability lib this
 ;; blueprint's own README names (SKU/EAN-13/POS/inventory pure-data
 ;; contracts) -- this actor wraps it with the governed-actor layer
 ;; rather than reimplementing barcode/receipt logic. This repo is
 ;; standalone (forkable outside the workspace); the :local/root paths
 ;; only resolve inside the monorepo checkout -- a standalone fork
 ;; should override them with git coordinates.
 :deps {
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "f9ef46980869cc0bedddc3c552ccfd7add7cffe0"}
        ;; html/css を top-level で git 座標に固定する。推移依存(:local/root)と
        ;; jp-go-dds(:git/sha)で座標型が違うと tools.deps が版を比較できない。
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/html" :git/sha "00a4c2ad43dde3df9d54b658961143c53945a379"}
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/css" :git/sha "6eda5ee28ec177b9e09fdbee92c55a050b18cf7d"}
io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/retail
        {:local/root "../../kotoba-lang/retail"}
        ;; langchain-store: the shared langchain.db store seam (EDN-blob
        ;; codec + identity schema + event-log helpers) that ~190 actors
        ;; hand-roll; retailops.store is an adopter (ADR-2607141600).
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "retailops.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate docs/samples/operator-console.html
  ;; through the real actor (flagship checklist item 2, ADR-2607189300 Wave5).
  :render-html {:main-opts ["-m" "retailops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
